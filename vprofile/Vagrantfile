### tomcat vm ###
   config.vm.define "app01" do |app01|
    app01.vm.box = "generic/rocky9"
    app01.vm.hostname = "app01"
    app01.vm.network "private_network", ip: "192.168.1.120"
    app01.vm.synced_folder("./app01", "/opt/vagrant",type: "rsync")
    app01.vm.provision "shell", path: "scripts/app01.sh" , run: "always"
    
    app01.vm.provider "vmware_esxi" do |esxi|
      esxi.guest_memsize= "800"
      esxi.esxi_hostname = "esxi"
      esxi.esxi_username = "root"
      esxi.esxi_password = "P@ssw0rd"
      esxi.esxi_disk_store = "datastore1"
      esxi.esxi_virtual_network = ["VM Network"]
      esxi.guest_name = "app01"
      esxi.guest_numvcpus = "1"
    end
   end
   
  
### Nginx VM ###


